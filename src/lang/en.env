# Default English messages for file-organiser.
# Machine names on the left never change; only the values should be translated.
# Templates use positional placeholders {0}, {1}, ... which may be reordered.
#
# To add a new language, copy this file to lang/<code>.env (e.g. lang/fr.env
# for French) in a "lang" directory next to the file-organiser executable -
# no source code changes needed. It's picked up automatically when the
# system's LC_ALL/LANG locale matches <code>. Only include the keys you want
# to translate; anything missing falls back to English. FO_LANG_DIR
# redirects where that directory is looked up, and FO_LANG_FILE points at a
# single file that always wins regardless of the detected locale.

# Headers
FO_HEADER_OVERVIEW=OVERVIEW
FO_HEADER_CRITERIA=CRITERIA
FO_HEADER_BY_EXTENSION=BY EXTENSION

# OVERVIEW labels
FO_LABEL_PATH=path
FO_LABEL_TOTAL_FILES=total files
FO_LABEL_NEWEST=newest
FO_LABEL_OLDEST=oldest
FO_LABEL_TOTAL_SIZE=tot. size
FO_LABEL_MIN_SIZE=min. size
FO_LABEL_MAX_SIZE=max. size
FO_LABEL_MAX_DEPTH=max depth
FO_MAX_DEPTH_LIMIT=(limit: {0})

# CRITERIA labels
FO_LABEL_SIZE_RANGE=size range
FO_LABEL_EXTENSIONS=extensions
FO_LABEL_FILE_NAMES=file names
FO_LABEL_ACTION=action
FO_ALL_SIZES=[all]
FO_ALL_EXTENSIONS=[all]
FO_MATCHING=matching
FO_NOT_MATCHING=not matching
FO_JOINER_AND=and
FO_SIZE_PREFIX_MIN=min.
FO_SIZE_PREFIX_MAX=max.

# Action words (past tense, and negated past tense)
FO_ACTION_LISTED=listed
FO_ACTION_NOT_LISTED=not listed
FO_ACTION_MOVED=moved
FO_ACTION_NOT_MOVED=not moved
FO_ACTION_COPIED=copied
FO_ACTION_NOT_COPIED=not copied
FO_ACTION_DELETED=deleted
FO_ACTION_NOT_DELETED=not deleted
FO_ACTION_MOVE_TO=move to
FO_ACTION_COPY_TO=copy to
FO_ACTION_DELETE=delete
FO_ACTION_LIST=list

# Per-file / summary line
FO_DELETED_TAG=[del]
FO_TO_TARGET=to {0}
FO_RUN_SUMMARY={0} {1} {2} ({3}){4}

# Units and pluralization
FO_UNIT_DAY=day
FO_UNIT_HOUR=hour
FO_UNIT_MIN=min
FO_UNIT_SEC=sec
FO_UNIT_YEAR=year
FO_UNIT_FILE=file
FO_UNIT_SUBDIR=subdir
FO_NO_SUBDIRS=[no subdirs]
FO_NO_EXTENSION=[none]
FO_SUFFIX_PLURAL_S=s
FO_ABBR_HOUR=h
FO_ABBR_MIN=m
FO_ABBR_SEC=s

# Age phrases
FO_ALL_AGES=All ages
FO_AGE_NEWER=newer
FO_AGE_OLDER=older
FO_AGE_BETWEEN=between {0} and {1} old
FO_AGE_THAN={0} than {1}
FO_AGE_OLD={0} old

# Prompts and confirmation messages
FO_PROMPT_FORMAT={0} (Y/n)
FO_CONFIRM_YES_VALUES=y,yes
FO_READ_LINE_ERROR=Error: Could not read a line
FO_CONFIRM_DELETE=Are you sure you want to delete the {0} above {1}?
FO_NOT_DELETED=Not deleted
FO_NO_MATCHED_FILES=No matched files to delete
FO_LABEL_TARGET_DIRECTORY=target directory
FO_CREATE_TARGET_PROMPT=Target directory {0} does not exist. Do you want to create it and all required subdirectories?
FO_TARGET_CREATE_FAILED=New target directory ({0}) could not be created
FO_SOURCE_DIR_MISSING=The target directory {0} does not exist
